# Narrow IMS-only property type for the stock sys.smf.mnoname prefix.
system_internal_prop(m11q_ims_prop)

# Per-slot MMTEL support state published only by the Samsung IMS application.
system_internal_prop(m11q_ims_supportmmtel_prop)

# Legacy Samsung emergency-timer property consumed across the telephony HAL boundary.
system_public_prop(m11q_twwan911_prop)
get_prop(hal_telephony_server, m11q_twwan911_prop)

# GSM SMS TP-Message-Reference counter owned by the Samsung IMS application.
system_internal_prop(m11q_ims_sms_tpmr_prop)

# Service-specific init control property; does not grant generic ctl.start.
system_internal_prop(m11q_eris_ctl_prop)

# Current default-data phone ID published by the Samsung ePDG service.
system_internal_prop(m11q_epdg_default_data_prop)

# Exact Samsung ePDG state properties shared with the telephony HAL.
system_public_prop(m11q_epdg_radio_prop)
get_prop(hal_telephony_server, m11q_epdg_radio_prop)
