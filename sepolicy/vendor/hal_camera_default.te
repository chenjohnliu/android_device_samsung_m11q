set_prop(hal_camera_default, sec_camera_prop)

allow hal_camera_default sysfs_graphics:file r_file_perms;
dontaudit hal_camera_default bootanim_system_prop:file { getattr open read map };
dontaudit hal_camera_default system_prop:file { getattr open read map };
dontaudit hal_camera_default default_prop:file { getattr open read map };
