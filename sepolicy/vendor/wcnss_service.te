allow wcnss_service kmsg_device:chr_file w_file_perms;

allow wcnss_service wifi_vendor_wpa_socket:dir create_dir_perms;
allow wcnss_service wifi_vendor_wpa_socket:sock_file create_file_perms;

allow wcnss_service vendor_shell_exec:file rx_file_perms;

dontaudit wcnss_service wifi_data_file:dir search;
dontaudit wcnss_service system_prop:file { getattr open read map };
dontaudit wcnss_service serialno_prop:file { getattr open read map };

set_prop(wcnss_service, vendor_wifi_prop)
