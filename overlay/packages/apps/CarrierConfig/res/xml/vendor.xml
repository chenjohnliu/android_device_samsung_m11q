<!-- Samsung-profile-backed ePDG allowlist; unknown carriers fail closed. -->
<carrier_config_list>
    <!-- Force a fresh WWAN IMS bearer after leaving IWLAN. This intentionally
         trades active VoWiFi call continuity for clean post-WFC IMS state. -->
    <carrier_config mcc="466" mnc="01">
        <boolean name="carrier_wfc_ims_available_bool" value="true"/>
        <boolean name="carrier_default_wfc_ims_enabled_bool" value="false"/>
        <string-array name="iwlan_handover_policy_string_array" num="2">
            <item value="source=IWLAN, target=EUTRAN, type=disallowed, capabilities=IMS"/>
            <item value="source=GERAN|UTRAN|EUTRAN|NGRAN|IWLAN, target=GERAN|UTRAN|EUTRAN|NGRAN|IWLAN, type=allowed"/>
        </string-array>
        <string name="carrier_data_service_wlan_package_override_string">com.sec.epdg</string>
        <string name="carrier_network_service_wlan_package_override_string">com.sec.epdg</string>
        <string name="carrier_qualified_networks_service_package_override_string">com.sec.epdg</string>
